{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "customConditions": ["react-native-strict-api", "react-native"],
    "skipLibCheck": true,
    "paths": {
      "expo/src/*": ["./src/types/empty.d.ts"],
      "expo-modules-core/src/*": ["./src/types/empty.d.ts"],
      "expo-modules-core": ["./src/types/empty.d.ts"],
      "expo-modules-core/*": ["./src/types/empty.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "App.tsx",
    "index.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
